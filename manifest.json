{
  "manifest_version": 3,
  "name": "Close to Tray",
  "version": "1.0.5",
  "homepage_url": "https://github.com/idevin/thunderbird-system-tray-icon",
  "description": "When you close Thunderbird's main window, keep it running in the system tray instead of quitting. https://creotech.org",
  "author": "Ilya Devin",
  "browser_specific_settings": {
    "gecko": {
      "id": "close-to-tray@localhost",
      "strict_min_version": "128.0",
      "strict_max_version": "158.*"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "closeToTray": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["closeToTray"]],
        "script": "experiment/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
